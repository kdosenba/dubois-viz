{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": [
    "src/index.ts",
    "src/contracts/**/*.ts",
    "src/charts/**/*.ts",
    "src/sync/**/*.ts",
    "src/controls/**/*.ts",
    "src/plates/**/*.ts"
  ],
  "exclude": [
    "src/showcase/**/*",
    "src/**/*.test-d.ts",
    "node_modules",
    "dist"
  ]
}
